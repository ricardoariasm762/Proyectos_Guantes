      "name": "1. Auth",
      "item": [
        {
          "name": "API-01: Registro de Estudiante",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Retorna token JWT y rol ESTUDIANTE', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('token');",
                  "    pm.expect(json.rol).to.eql('ESTUDIANTE');",
                  "    pm.collectionVariables.set('token_estudiante', json.token);",
                  "    pm.collectionVariables.set('usuario_id', json.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Estudiante\",\n  \"apellido\": \"Prueba\",\n  \"email\": \"prueba@ucc.edu.co\",\n  \"password\": \"prueba123456\",\n  \"rol\": \"ESTUDIANTE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
